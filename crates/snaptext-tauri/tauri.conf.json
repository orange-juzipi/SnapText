{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapText",
  "version": "0.1.0",
  "identifier": "com.snaptext.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "cd ../ui && bun run dev",
    "beforeBuildCommand": "cd ../.. && python3 scripts/build_tauri_frontend.py"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 640,
        "minWidth": 980,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../models": "models",
      "../../python/ocr_worker.py": "python/ocr_worker.py"
    }
  }
}
